{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "heatmap", "name": "Heatmap", "version": "" },
    { "type": "panel", "id": "state-timeline", "name": "State timeline", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" }
  ],
  "id": null,
  "uid": "hydra-main",
  "title": "Hydra Trading Platform",
  "description": "Comprehensive monitoring for the Hydra Bitcoin auto-trading platform",
  "tags": ["hydra", "trading", "bitcoin"],
  "style": "dark",
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "exchange_id",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(hydra_feed_bars_total, exchange_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "strategy_id",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(hydra_signal_count_total, strategy_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "symbol",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(hydra_position_size, symbol)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Trading Performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Equity Curve",
      "description": "Total portfolio value over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "hydra_portfolio_value",
          "legendFormat": "Portfolio Value (USDT)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#73BF69" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": true,
            "axisCenteredZero": false
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Daily PnL",
      "description": "Daily realized + unrealized PnL in USDT",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "hydra_daily_pnl",
          "legendFormat": "Daily PnL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "scheme"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Drawdown %",
      "description": "Current drawdown from peak equity (metric is a fraction, 0.05 = 5%)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "hydra_drawdown_ratio",
          "legendFormat": "Drawdown"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#F2495C" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.03 },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.10 },
              { "color": "dark-red", "value": 0.15 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Strategy Monitor",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Signals per Strategy",
      "description": "Signal count rate grouped by strategy_id",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (strategy_id) (rate(hydra_signal_count_total[$__rate_interval]))",
          "legendFormat": "{{ strategy_id }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "stacking": { "mode": "none" },
            "spanNulls": true
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "heatmap",
      "title": "Order Fill Latency",
      "description": "Distribution of OrderManager submit-to-fill latency (all sessions)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(hydra_order_fill_latency_seconds_bucket[$__rate_interval]))",
          "legendFormat": "{{ le }}",
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "scheme", "schemeId": "Oranges" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
        },
        "overrides": []
      },
      "options": {
        "calculate": true,
        "yAxis": { "unit": "s" },
        "color": { "scheme": "Oranges", "fill": "dark-orange", "exponent": 0.5 },
        "cellGap": 1,
        "tooltip": { "show": true }
      }
    },
    {
      "id": 300,
      "type": "row",
      "title": "Risk Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "state-timeline",
      "title": "Circuit Breaker Tier",
      "description": "Live breaker tier from the RiskService per scope (hydra_circuit_breaker_active_tier); a tier latches until it auto-resets or an operator resets it",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (scope) (hydra_circuit_breaker_active_tier)",
          "legendFormat": "{{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 2 },
              { "color": "red", "value": 3 },
              { "color": "dark-red", "value": 4 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "None", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "Tier 1: reduce_size_50", "color": "yellow" } } },
            { "type": "value", "options": { "2": { "text": "Tier 2: halt_new_trades", "color": "orange" } } },
            { "type": "value", "options": { "3": { "text": "Tier 3: flatten_all", "color": "red" } } },
            { "type": "value", "options": { "4": { "text": "Tier 4: emergency_shutdown", "color": "dark-red" } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "rowHeight": 0.8,
        "mergeValues": true,
        "alignValue": "left"
      }
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "Portfolio Heat",
      "description": "Gross open exposure across sessions divided by account equity (default cap 0.30)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "hydra_portfolio_heat_ratio",
          "legendFormat": "Heat"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.50,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.20 },
              { "color": "red", "value": 0.30 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 11,
      "type": "piechart",
      "title": "Position Exposure by Symbol",
      "description": "Gross open position size per symbol, summed over sessions",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (symbol) (abs(hydra_position_size))",
          "legendFormat": "{{ symbol }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "donut",
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 400,
      "type": "row",
      "title": "System Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Exchange API Latency (p50 / p99)",
      "description": "Latency percentiles for exchange REST API calls",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, exchange_id) (rate(hydra_exchange_api_latency_seconds_bucket{exchange_id=~\"$exchange_id\"}[$__rate_interval])))",
          "legendFormat": "{{ exchange_id }} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, exchange_id) (rate(hydra_exchange_api_latency_seconds_bucket{exchange_id=~\"$exchange_id\"}[$__rate_interval])))",
          "legendFormat": "{{ exchange_id }} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "p99" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "WebSocket Status",
      "description": "WebSocket reconnections in the last 5 minutes",
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (exchange_id) (increase(hydra_ws_reconnects_total{exchange_id=~\"$exchange_id\"}[5m]))",
          "legendFormat": "{{ exchange_id }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Memory / CPU Usage",
      "description": "Container resource usage from node_exporter or cAdvisor",
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"hydra\"} / 1024 / 1024",
          "legendFormat": "RSS (MB)"
        },
        {
          "refId": "B",
          "expr": "rate(process_cpu_seconds_total{job=\"hydra\"}[$__rate_interval]) * 100",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "RSS (MB)" },
            "properties": [{ "id": "unit", "value": "mbytes" }]
          },
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Error Rate",
      "description": "Failed or timed-out exchange API calls and WebSocket reconnects per second",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (exchange_id) (rate(hydra_ws_reconnects_total{exchange_id=~\"$exchange_id\"}[$__rate_interval]))",
          "legendFormat": "{{ exchange_id }} WS reconnects/s"
        },
        {
          "refId": "B",
          "expr": "sum by (exchange_id) (rate(hydra_exchange_api_errors_total{exchange_id=~\"$exchange_id\"}[$__rate_interval]))",
          "legendFormat": "{{ exchange_id }} API errors/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#F2495C" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 600,
      "type": "row",
      "title": "Trades",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Win Rate",
      "description": "Share of closing paper fills in the selected range with net PnL above 0 USDT (fees included); break-even counts as a loss. Opening fills are not counted.",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - sum(increase(hydra_trade_pnl_bucket{le=\"0.0\"}[$__range])) / sum(increase(hydra_trade_pnl_count[$__range]))",
          "legendFormat": "Win rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.4 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 20,
      "type": "heatmap",
      "title": "Net PnL per Closing Fill",
      "description": "Distribution of net PnL (USDT, fees included) of closing paper fills",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (increase(hydra_trade_pnl_bucket[$__rate_interval]))",
          "legendFormat": "{{ le }}",
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "scheme", "schemeId": "RdYlGn" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": { "unit": "currencyUSD" },
        "color": { "scheme": "RdYlGn", "fill": "dark-green", "exponent": 0.5 },
        "cellGap": 1,
        "tooltip": { "show": true }
      }
    },
    {
      "id": 700,
      "type": "row",
      "title": "Sessions & Readiness",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 53 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "state-timeline",
      "title": "Readiness by Check",
      "description": "hydra_ready per check, set by the engine health monitor (GET /readyz names the cause)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "hydra_ready", "legendFormat": "{{ check }}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Not ready", "color": "red" },
                "1": { "text": "Ready", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": { "showValue": "never", "rowHeight": 0.8 }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Sessions: Desired vs Supervised",
      "description": "Running in the database vs a live task in the engine; a zombie is desired without supervision",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(hydra_session_desired)", "legendFormat": "Desired (DB running)" },
        { "refId": "B", "expr": "sum(hydra_session_supervised)", "legendFormat": "Supervised (task alive)" },
        {
          "refId": "C",
          "expr": "count(hydra_session_desired == 1 unless on (session_id) hydra_session_supervised == 1) or vector(0)",
          "legendFormat": "Zombies"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Feed Message Age",
      "description": "Seconds since the last market-data message per stream (HydraFeedStale above 120s)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - hydra_feed_last_message_timestamp_seconds{exchange_id=~\"$exchange_id\"}",
