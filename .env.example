# Every variable the engine and the test suite read. The engine does not load this file: export it
# (set -a; . ./.env; set +a) or pass `--env-file .env` to docker compose.

# --- Infrastructure (env only; never in config/*.yaml) ---
DATABASE_URL=postgresql://hydra:hydra_dev@localhost:5432/hydra
REDIS_URL=redis://localhost:6379/0
# Required whenever DATABASE_URL is set; never generated. Create one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: "new,old" (the first key encrypts, every key decrypts).
HYDRA_CREDENTIAL_KEY=
# Bearer token for service clients, at least 32 characters (optional).
# HYDRA_API_TOKEN=

# --- Config selection ---
# HYDRA_CONFIG_DIR=./config
# HYDRA_ENV=base

# --- Behaviour overrides: HYDRA_<SECTION>__<KEY> beats config/*.yaml ---
HYDRA_LOGGING__LEVEL=INFO
HYDRA_LOGGING__FORMAT=json
# HYDRA_TRADING__TESTNET=true
# HYDRA_API__CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# HYDRA_API__AUTH_MODE=proxy
# HYDRA_API__TRUSTED_PROXY_CIDRS=
# HYDRA_ML__MODELS_DIR=/app/models

# --- Compose interpolation (deploy/compose.yml, docker-compose.ml.yml) ---
HYDRA_DB_PASSWORD=hydra_dev

# --- Integration tests only (tests/infra.py builds its own DSNs from these) ---
# HYDRA_DB_HOST=localhost
# HYDRA_DB_PORT=5432
# HYDRA_DB_NAME=hydra
# HYDRA_DB_USER=hydra
# HYDRA_REDIS_URL=redis://localhost:6379/0
# HYDRA_REQUIRE_INFRA=1

# --- ML (P5) ---
MLFLOW_TRACKING_URI=http://localhost:5000
