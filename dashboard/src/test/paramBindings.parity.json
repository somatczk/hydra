{
  "_comment": "One rule set, two resolvers: strategy/builtin/rule_based.py param_bindings and dashboard/src/components/builder/bindings.ts paramBindings (fed `catalogue`, the registry's params and defaults, pinned to the engine's signature by the Python test) must both produce `bindable` and `ambiguous` (tests/unit/test_strategy/test_param_bindings_parity.py, bindings.test.ts). entry_short pins the catalogue cases: an override the condition's params lack binds the signature default, and a value_ref_overrides key the compared indicator does not take (bbu_typo) binds nothing. `refused` is one condition whose param_overrides names a parameter its indicator lacks: the engine raises at that site and unknownTargets names the same binding.",
  "rules": {
    "entry_long": {
      "operator": "AND",
      "conditions": [
        {
          "indicator": "rsi",
          "params": {
            "period": 14
          },
          "comparator": "less_than",
          "value": 30,
          "param_key": "rsi_len",
          "value_param_key": "rsi_lower"
        },
        {
          "indicator": "close",
          "params": {},
          "comparator": "crosses_above",
          "value": "sma:period=50",
          "value_ref_overrides": {
            "slow_len": "period"
          }
        },
        {
          "indicator": "ema",
          "params": {
            "period": 20
          },
          "comparator": "greater_than",
          "value": "sma:period=100"
        }
      ]
    },
    "exit_long": {
      "operator": "OR",
      "conditions": [
        {
          "indicator": "bollinger_upper",
          "params": {
            "period": 20,
            "std_dev": 2.0
          },
          "comparator": "less_than",
          "value": "close",
          "param_overrides": {
            "bb_len": "period",
            "bb_dev": "std_dev"
          }
        },
        {
          "indicator": "adx",
          "params": {
            "period": 14
          },
          "comparator": "greater_than",
          "value": 25,
          "param_overrides": {}
        },
        {
          "indicator": "close",
          "params": {},
          "comparator": "less_than",
          "value": "sma:period=200",
          "value_param_key": "ignored_on_a_reference"
        }
      ]
    },
    "entry_short": {
      "operator": "AND",
      "conditions": [
        {
          "indicator": "bollinger_lower",
          "params": {
            "period": 20
          },
          "comparator": "greater_than",
